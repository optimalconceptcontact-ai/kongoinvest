APP_NAME=KongoInvest
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
CASHIER_CURRENCY=usd

# AI (laravel/ai). AI_DEFAULT_PROVIDER is the SDK-wide default; the
# product features (project analysis, coach, advisor, contract draft)
# read AI_FEATURES_*. With AI_FEATURES_ENABLED=true but no API key for
# the chosen provider, every feature degrades to a clean retry state.
AI_DEFAULT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
AI_FEATURES_ENABLED=true
AI_FEATURES_PROVIDER=deepseek
# Leave blank to use deepseek-chat. Set explicitly if you change provider.
AI_FEATURES_MODEL=
# Per-call HTTP timeout in seconds. MUST stay below PHP's max_execution_time
# (30s on Herd) or a slow provider fatals the request instead of retrying.
AI_FEATURES_TIMEOUT=20
MATCHING_AI_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
